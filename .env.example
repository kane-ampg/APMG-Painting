# ---------------------------------------------------------------
# APMG Painting — environment configuration
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------

# Canonical origin used for metadataBase, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Enquiry delivery -------------------------------------------
# NOT YET PROVISIONED. Until these exist the app uses the console
# adapter, which logs that a submission occurred and nothing else.
# The UI never claims a message was delivered when it was not.
ENQUIRY_TRANSPORT="console"          # console | resend
RESEND_API_KEY=""
ENQUIRY_TO_EMAIL=""
ENQUIRY_FROM_EMAIL=""

# --- Analytics (carry across from the WordPress site) -----------
# Leave blank locally so development traffic is never counted.
NEXT_PUBLIC_GTM_ID=""                # live value: GTM-N7D3JPMV
NEXT_PUBLIC_CALLRAIL_SCRIPT=""       # live value: //cdn.callrail.com/companies/384170337/.../swap.js

# --- CMS (Supabase) ---------------------------------------------------
# Leave blank to run from the TypeScript content files with no database.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Seed script only. Never read at runtime.
SUPABASE_SERVICE_ROLE_KEY=""
# AI assist in the admin. Blank disables the buttons.
ANTHROPIC_API_KEY=""
# Demo only. "true" publishes /admin read-only on a deployment with no
# database and no login: the editor renders the built-in content and every
# save reports that nothing was stored. Never set this alongside the Supabase
# keys above — they win — and remove it from the deployment once the backend
# is wired.
CMS_PREVIEW_MODE=""

# --- Deployment role (spec §8a) ------------------------------------
# "site" (default) serves the public website and blocks /admin.
# "editor" serves only /admin and blocks the public routes.
NEXT_PUBLIC_APP_ROLE="site"
# Site role: where /admin should send people. Editor role: unused.
EDITOR_ORIGIN=""
# Editor role: the public site to refresh after a publish. Site role: unused.
PUBLIC_SITE_ORIGIN=""
# Both roles, identical value. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=""
